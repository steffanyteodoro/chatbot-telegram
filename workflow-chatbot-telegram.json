      "id": "3b043d3e-c826-443c-82df-a0592449ed67",
      "name": "Resposta Válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -224,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extrai e formata os dados da resposta da OpenWeather\nconst body = $input.item.json.body;\nconst data = typeof body === 'string' ? JSON.parse(body) : body;\n\nconst cityName = data.name || 'Cidade Desconhecida';\nconst tempRaw = data.main?.temp;\nconst temp = tempRaw !== undefined ? Math.round(tempRaw) : null;\nconst description = data.weather?.[0]?.description || '';\nconst humidity = data.main?.humidity;\nconst feelsLike = data.main?.feels_like !== undefined ? Math.round(data.main.feels_like) : null;\n\n// Escolhe emoji baseado na temperatura\nlet emoji = '🌤️';\nif (temp !== null) {\n  if (temp >= 35) emoji = '🔥';\n  else if (temp >= 28) emoji = '☀️';\n  else if (temp >= 20) emoji = '🌤️';\n  else if (temp >= 15) emoji = '⛅';\n  else if (temp >= 10) emoji = '🌥️';\n  else emoji = '🥶';\n}\n\n// Capitaliza nome da cidade\nconst formattedCity = cityName\n  .split(' ')\n  .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())\n  .join(' ');\n\n// Monta mensagem determinística (também usada como fallback do Gemini)\nlet message;\nif (temp !== null) {\n  message = `${emoji} A temperatura em ${formattedCity} é de ${temp}°C.`;\n  if (description) {\n    const desc = description.charAt(0).toUpperCase() + description.slice(1);\n    message += `\\n🌡️ Sensação térmica: ${feelsLike}°C | ${desc}`;\n  }\n  if (humidity !== undefined) {\n    message += `\\n💧 Umidade: ${humidity}%`;\n  }\n} else {\n  message = `${emoji} Temperatura em ${formattedCity} indisponível no momento.`;\n}\n\nreturn {\n  message,\n  city: formattedCity,\n  temp,\n  description,\n  humidity,\n  feelsLike,\n  ok: true\n};"
      },
